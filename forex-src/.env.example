# DDS Finance — variáveis do front-end (opcionais; sem elas o build usa os valores de src/config.ts).
# Só valores PÚBLICOS entram aqui: tudo que começa com VITE_ vai para o navegador.
# Nunca coloque a chave de serviço (service_role / secret) neste arquivo.
VITE_SUPABASE_URL=https://arffptuclrrzuzdrcmuc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
# WhatsApp do administrador (DDI + DDD + número, só dígitos) para "Esqueci meu PIN"
VITE_ADMIN_WHATSAPP=5541999999999

# Testes (não vão para o navegador)
# DDS_CSV=/caminho/para/transactions.csv      → testes com o arquivo real (npm test / npm run test:e2e)
# PW_CHROMIUM=/caminho/para/chrome             → navegador usado pelo Playwright

# Edge Function forex-ptax: usa SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY, que o Supabase injeta sozinho.
